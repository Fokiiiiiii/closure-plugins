module-description = Gives experience for messages, levels with role rewards, and a leaderboard.
command-rank = rank
    .description = Show the level and experience of a member
option-rank-user = user
    .description = The member; yourself when left out
command-leaderboard = leaderboard
    .description = Show the members with the most experience
command-xp = xp
    .description = Change the experience of a member
subcommand-xp-add = add
    .description = Give experience, or take it with a negative number
subcommand-xp-set = set
    .description = Set the experience of a member
subcommand-xp-reset = reset
    .description = Take all the experience of a member
option-xp-add-user = user
    .description = The member
option-xp-add-amount = amount
    .description = How much experience; negative takes it away
option-xp-set-user = user
    .description = The member
option-xp-set-amount = amount
    .description = The experience the member has afterwards
option-xp-reset-user = user
    .description = The member
permission-leveling-view = See the level and the leaderboard
permission-leveling-manage = Change the experience of members
config-leveling-xp_per_message = Experience a message gives.
config-leveling-cooldown_seconds = Seconds before the same member can get experience again; flooding does not pay.
config-leveling-ignored_channels = Channels where messages give no experience.
config-leveling-announce = Announce a new level.
config-leveling-announce_channel = Where levels are announced; the channel of the message when none is chosen.
config-leveling-rewards = Roles given when a member reaches a level.
leveling-up = { $user } reached level { $level }.
leveling-reward-reason = A level was reached
leveling-level = Level
leveling-xp = Experience
leveling-position = Rank
leveling-leaderboard = Leaderboard
leveling-empty = Nobody has any experience yet.
leveling-set = { $user } now has { $xp } experience, level { $level }.
config-leveling-voice_xp_per_minute = Experience for each minute in a voice channel, given when the member leaves it; 0 gives none.
config-leveling-role_multipliers = Roles that make experience worth more or less, in percent (100 is as it is). The best of a member's roles counts.
config-leveling-channel_multipliers = Channels where experience is worth more or less, in percent (100 is as it is).
config-leveling-replace_rewards = A reward role takes the reward roles of the earlier levels away.
