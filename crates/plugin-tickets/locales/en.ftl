module-description = Support tickets: a button opens a private channel for the member and the staff, and closing it saves a transcript.
command-ticket = ticket
    .description = Run the tickets
subcommand-ticket-panel = panel
    .description = Post the message with the button that opens a ticket
subcommand-ticket-close = close
    .description = Close this ticket and save its transcript
subcommand-ticket-add = add
    .description = Let a member into this ticket
subcommand-ticket-remove = remove
    .description = Take a member out of this ticket
option-ticket-panel-channel = channel
    .description = Where the message goes; this channel when left out
option-ticket-panel-text = text
    .description = What the message says
option-ticket-close-reason = reason
    .description = Why it is closed
option-ticket-add-user = user
    .description = The member
option-ticket-remove-user = user
    .description = The member
permission-tickets-manage = Post the panel, claim and change who is in a ticket
permission-tickets-use = Close a ticket of your own
config-tickets-category = The category the tickets are made in.
config-tickets-staff_roles = The roles that see every ticket. Tickets are off until one is chosen.
config-tickets-log_channel = The channel the transcripts go to. Without one no transcript is kept.
config-tickets-max_open = How many tickets a member may have open at once.
config-tickets-close_after_days = Close a ticket nobody has written in for this many days; 0 never closes one.
tickets-panel-text = Need help? Press the button to open a ticket. Only you and the staff will see it.
tickets-open-button = Open a ticket
tickets-claim-button = Claim
tickets-close-button = Close
tickets-panel-done = The message with the button is posted.
tickets-not-set-up = Tickets are not set up here: no staff role is chosen.
tickets-limit = You have { $max } open already. Close one first.
tickets-failed = That did not work just now. Try again in a moment.
tickets-opened = Your ticket is open: { $channel }
tickets-welcome = { $user }, this is ticket #{ $number }. Tell us what you need; the staff will be with you.
tickets-claimed = { $user } takes this ticket.
tickets-claim-done = You took this ticket.
tickets-claimed-already = { $user } took this ticket already.
tickets-staff-only = Only the staff can do that.
tickets-not-a-ticket = This is not an open ticket.
tickets-not-yours = Only the member who opened this ticket, or the staff, can close it.
tickets-closing = Closing the ticket.
tickets-closed-by = Closed by { $user }
tickets-idle-reason = Closed: nobody wrote in it for a long time
tickets-reason-open = A member opened a ticket
tickets-reason-member = Who is in a ticket changed
tickets-added = { $user } can see this ticket now.
tickets-removed = { $user } cannot see this ticket any more.
tickets-closed-log = Ticket #{ $number } of { $opener } is closed by { $closer }. { $reason }
tickets-transcript-head = Ticket #{ $number } of { $opener }
tickets-transcript-cut = Only the newest { $count } messages are kept here; older ones were not saved.
