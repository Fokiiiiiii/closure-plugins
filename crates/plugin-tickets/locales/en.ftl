    .description = The member
option-ticket-transfer-user = user
    .description = The staff member who will take over
option-ticket-rename-name = name
    .description = The new channel name
option-ticket-search-query = query
    .description = Ticket number, member ID, exact label, close reason, transcript text, or form answer
option-ticket-label-add-label = label
    .description = The label (1 to 64 characters)
option-ticket-label-remove-label = label
    .description = The label to remove
option-ticket-label-list-page = page
    .description = Page number (starts at 1)
option-ticket-note-text = text
    .description = The note (up to 300 characters)
option-ticket-notes-ticket = ticket
