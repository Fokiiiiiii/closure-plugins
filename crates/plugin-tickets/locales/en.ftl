config-tickets-question-min-values = Minimum selections for a multi-select question (0–25; defaults to 0).
config-tickets-question-max-values = Maximum selections for a multi-select question (1–25).
config-tickets-close_when_opener_leaves = Close tickets opened by members when they leave this server.
tickets-opener-left-reason = The ticket opener left the server.
tickets-panel-unavailable = This panel was not found.
tickets-panel-duplicate = This panel ID is used more than once.
