module-description = Support tickets: members choose a panel to open a private channel for themselves and the staff, and closing it saves a transcript.
command-ticket = ticket
    .description = Run the tickets
subcommand-ticket-panel = panel
    .description = Publish the message members use to open a ticket
subcommand-ticket-search = search
    .description = Search closed histories by ticket number, member ID, exact label, close reason, transcript text, or form answer. Shows up to eight results per batch; continue with the private button.
subcommand-ticket-history = history
    .description = View a saved ticket transcript by number
subcommand-ticket-close = close
    .description = Close this ticket and save its transcript
subcommand-ticket-answers = answers
    .description = Resend saved form answers in this ticket
subcommand-ticket-close-request = close-request
    .description = Ask the ticket opener to confirm closure
subcommand-ticket-add = add
    .description = Let a member into this ticket
subcommand-ticket-remove = remove
    .description = Take a member out of this ticket
subcommand-ticket-unclaim = unclaim
    .description = Remove the assignee from this ticket
subcommand-ticket-transfer = transfer
    .description = Give this ticket to another staff member
subcommand-ticket-rename = rename
    .description = Rename this ticket channel
subcommand-ticket-stats = stats
    .description = Show the current ticket counts
subcommand-ticket-label-add = label-add
    .description = Add a label to this ticket
subcommand-ticket-label-remove = label-remove
    .description = Remove a label from this ticket
subcommand-ticket-label-list = label-list
    .description = Show labels on this ticket
subcommand-ticket-note = note
    .description = Add a private staff note to this ticket
subcommand-ticket-notes = notes
    .description = View staff notes by ticket ID. Each page is kept for one year after its last update.
subcommand-ticket-reply-search = reply-search
    .description = Search and select a saved reply for this ticket
subcommand-ticket-reply-add = reply-add
    .description = Add a saved reply for this panel
subcommand-ticket-reply-edit = reply-edit
    .description = Edit a saved reply for this panel
subcommand-ticket-reply-delete = reply-delete
    .description = Remove a saved reply from this panel
option-ticket-panel-panel = panel
    .description = A panel ID to publish alone; omit to publish all configured panels
option-ticket-panel-channel = channel
    .description = Where the message goes; this channel when left out
option-ticket-panel-text = text
    .description = What the message says
option-ticket-panel-message = message
    .description = Existing panel message ID to update; omit to publish new messages
option-ticket-panel-page = page
    .description = Page to publish or update; omit to publish all or update page 1
option-ticket-close-reason = reason
