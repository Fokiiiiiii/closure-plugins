module-description = Feeds: post new items from feeds, such as YouTube channels, into a channel.
command-feed = feed
    .description = Follow feeds and post their new items
subcommand-feed-add = add
    .description = Add a feed that posts new items to a channel
subcommand-feed-list = list
    .description = List the feeds of this server
subcommand-feed-remove = remove
    .description = Remove a feed
subcommand-feed-test = test
    .description = Post the newest item of a feed as a test
subcommand-feed-resume = resume
    .description = Resume a paused feed
option-feed-add-kind = kind
    .description = What kind of feed: youtube, reddit, twitch, x or pixiv
option-feed-add-target = target
    .description = The feed: a YouTube channel id (UC...) or its link, a subreddit (r/name), an X user name, a Twitch login name or its link, or a Pixiv user id
option-feed-add-channel = channel
    .description = Where the new items are posted; this channel when left out
option-feed-add-role = role
    .description = The role mentioned with each new item; nobody when left out
option-feed-remove-id = id
    .description = The id of the feed, as /feed list shows it
option-feed-test-id = id
    .description = The id of the feed, as /feed list shows it
option-feed-resume-id = id
    .description = The id of the feed, as /feed list shows it
permission-feeds-manage = Manage feeds
feed-unknown-kind = I do not know that kind of feed. Use youtube, reddit, twitch, x or pixiv.
feed-unsupported-kind = { $kind } feeds are not available: they are not supported yet, or the operator has not set what they need (rsshub_base_url for X and Pixiv; twitch_client_id and twitch_client_secret for Twitch).
feed-handle-unsupported = A @handle is not supported yet. Give the channel link (https://www.youtube.com/channel/UC...) or its UC... id.
feed-bad-target = That is not something this kind of feed can follow. The target option says what each kind takes.
feed-full = This server already has the most feeds it may have.
feed-kind-full = This server already has the most feeds of this kind.
feed-exists = This feed already posts to that channel.
feed-channel-missing = That channel is not in this server.
feed-channel-denied = The bot cannot send messages in that channel.
feed-added = Feed added as { $id }. Its first look only records what is there; new items are posted after that.
feed-removed = Feed removed.
feed-not-found = No feed has that id.
feed-none = No feeds yet. Add one with /feed add.
feed-resumed = Feed resumed.
feed-tested = The newest item was posted as a test.
feed-busy = Too many feeds are being read right now. Try again in a moment.
feed-empty = That feed has no items yet.
feed-read-failed = The feed could not be read right now.
feed-more = { $count } more new items were not posted one by one.
feed-paused-channel-missing = paused: the channel is gone
feed-paused-channel-denied = paused: the bot may no longer post in the channel
feed-paused-failures = paused: the feed failed too many times in a row
